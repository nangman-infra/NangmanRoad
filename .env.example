PORT=8787
GLOBALPING_API_URL=https://api.globalping.io/v1/measurements
GLOBALPING_TOKEN=
# Probes asked per measurement; the path that answered on the most routers is shown.
GLOBALPING_PROBE_CANDIDATES=3
MEASUREMENT_PROVIDER=globalping
GEOIP_PROVIDER=ip-api
# Per-IP GeoIP answers are cached for a day; an answer with a source missing only for an hour.
GEOIP_CACHE_TTL_MS=86400000
GEOIP_PARTIAL_CACHE_MS=3600000
IP_API_URL=http://ip-api.com
IP_API_KEY=
IPINFO_TOKEN=
GEOIP_TIMEOUT_MS=1400
# RIPE IPmap measures instead of reading a registration, and answers slowly; it gets its own limit.
IPMAP_TIMEOUT_MS=2500
REVERSE_DNS_TIMEOUT_MS=900
IP2LOCATION_API_KEY=
GEOIP_SECONDARY=
VITE_CARTO_API_KEY=
# Typing this phrase in the search box reports what is left of the free tiers instead of
# measuring. Leave it empty and the report does not exist: the server answers 404 and no one
# can ask. The digest the page checks against lives in src/lib/budgetReport.ts; set this to
# the phrase that hashes to it, and keep the phrase out of the repository.
BUDGET_REPORT_KEY=
# Router-name tokens no code table knows, next to where the other evidence put the router,
# for whoever keeps the table (shown in the budget report). Default state/site-code-candidates.jsonl; off to stop writing.
SITE_CODE_CANDIDATES_FILE=
# Sent by npm run data:refresh -- peeringdb (a Jenkins agent variable; the server never fetches PeeringDB)
PEERINGDB_API_KEY=
