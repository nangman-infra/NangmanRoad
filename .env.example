PORT=8787
GLOBALPING_API_URL=https://api.globalping.io/v1/measurements
GLOBALPING_TOKEN=
# Probes asked per measurement; the path that answered on the most routers is shown.
GLOBALPING_PROBE_CANDIDATES=3
MEASUREMENT_PROVIDER=globalping
GEOIP_PROVIDER=ip-api
# Per-IP GeoIP answers are cached for a day; an answer with a source missing only for an hour.
GEOIP_CACHE_TTL_MS=86400000
GEOIP_PARTIAL_CACHE_MS=3600000
IP_API_URL=http://ip-api.com
IP_API_KEY=
IPINFO_TOKEN=
GEOIP_TIMEOUT_MS=1400
REVERSE_DNS_TIMEOUT_MS=900
IP2LOCATION_API_KEY=
GEOIP_SECONDARY=
VITE_CARTO_API_KEY=
